rules_version = '2';

// ===============================================================
// Assumed Data Model
// ===============================================================
//
// Application: MySch (Jurnal Harian Guru & Presensi Multi-Lembaga)
// Auth Architecture: Static export on Firebase Spark Plan using
//   client-side Institution Token + Name Picker + SHA-256 PIN
//   (and TOTP 2FA for user-superadmin) without Firebase Email/Password Auth.
//   Note: Because request.auth may be null, collection rules enforce
//   strict schema, type, enum, and size validation on all writes.
//
// Collection: institutions
// Document ID: {institutionId}
// Fields:
//   - id: string (optional, 1-100 chars, immutable if present)
//   - token_lembaga: string (required, 2-50 chars)
//   - name: string (required, 2-200 chars)
//   - education_level: string (required, 'SD' | 'SMP' | 'SMA' | 'SMK' | 'MI' | 'MTs')
//   - npsn: string (optional, 0-30 chars)
//   - address: string (optional, 0-500 chars)
//   - phone: string (optional, 0-30 chars)
//   - logo_url: string (optional, 0-500000 chars, URL, emoji, or compressed base64)
//   - is_active: bool (required)
//   - created_at: string | timestamp (required, immutable if present)
//
// Collection: users
// Document ID: {userId}
// Fields:
//   - id: string (optional, 1-100 chars, immutable if present)
//   - institution_id: string | null (required 1-100 chars for non-SUPER_ADMIN; optional/null/empty for SUPER_ADMIN)
//   - nip: string (required, 1-50 chars)
//   - name: string (required, 1-150 chars)
//   - phone: string (optional, 0-30 chars)
//   - pin: string (required, 0-128 chars, SHA-256 hash or 6-digit PIN)
//   - role: string (required, 'SUPER_ADMIN' | 'ADMIN' | 'TEACHER' | 'HEADMASTER')
//   - avatar_url: string (optional, 0-500000 chars, URL or compressed base64)
//   - subject_name: string (optional, 0-200 chars)
//   - subject_ids: list (optional, max 50 items)
//   - is_active: bool (required)
//   - totp_enabled: bool (optional)
//   - totp_secret: string (optional, 0-128 chars)
//   - email: string (optional, 0-150 chars)
//   - created_at: string | timestamp (optional, immutable if present)
//
// Collection: classes
// Document ID: {classId}
// Fields:
//   - id: string (optional, 1-100 chars, immutable if present)
//   - institution_id: string (required, 1-100 chars, immutable if present)
//   - name: string (required, 1-100 chars)
//   - grade_level: int | string (required, int 1-20 or string 1-30 chars)
//   - academic_year: string (required, 4-30 chars)
//   - homeroom_teacher_id: string (optional, 0-100 chars)
//   - created_at: string | timestamp (optional, immutable if present)
//
// Collection: students
// Document ID: {studentId}
// Fields:
//   - id: string (optional, 1-100 chars, immutable if present)
//   - institution_id: string (required, 1-100 chars, immutable if present)
//   - class_id: string (required, 1-100 chars)
//   - nisn: string (required, 1-30 chars)
//   - nipd: string (optional, 0-30 chars)
//   - full_name: string (required, 1-150 chars)
//   - gender: string (required, 'L' | 'P')
//   - is_active: bool (required)
//   - created_at: string | timestamp (optional, immutable if present)
//
// Collection: subjects
// Document ID: {subjectId}
// Fields:
//   - id: string (optional, 1-100 chars, immutable if present)
//   - institution_id: string (required, 1-100 chars, immutable if present)
//   - code: string (required, 1-30 chars)
//   - name: string (required, 1-150 chars)
//   - category: string (required, 'Wajib' | 'Pilihan' | 'Muatan Lokal')
//   - created_at: string | timestamp (optional, immutable if present)
//
// Collection: schedules
// Document ID: {scheduleId}
// Fields:
//   - id: string (optional, 1-100 chars, immutable if present)
//   - institution_id: string (required, 1-100 chars, immutable if present)
//   - teacher_id: string (required, 1-100 chars)
//   - class_id: string (required, 1-100 chars)
//   - subject_id: string (required, 1-100 chars)
//   - day_of_week: string (required, 'Senin' | 'Selasa' | 'Rabu' | 'Kamis' | 'Jumat' | 'Sabtu')
//   - start_period: int (required, 0-20)
//   - end_period: int (required, >= start_period and <= 20)
//   - start_time: string (required, 4-10 chars)
//   - end_time: string (required, 4-10 chars)
//   - academic_year: string (required, 4-30 chars)
//   - semester: int (required, 1 or 2)
//   - created_at: string | timestamp (optional, immutable if present)
//
// Collection: journals
// Document ID: {journalId}
// Fields:
//   - id: string (optional, 1-100 chars, immutable if present)
//   - institution_id: string (required, 1-100 chars, immutable if present)
//   - schedule_id: string (required, 1-100 chars)
//   - actual_teacher_id: string (required, 1-100 chars)
//   - teacher_name: string (required, 1-150 chars)
//   - class_name: string (required, 1-100 chars)
//   - subject_name: string (required, 1-150 chars)
//   - entry_date: string | timestamp (required, 8-30 chars or timestamp)
//   - start_time: string (required, 4-10 chars)
//   - end_time: string (required, 4-10 chars)
//   - start_period: int (required, 0-20)
//   - end_period: int (required, >= start_period and <= 20)
//   - learning_objective: string (required, 0-2000 chars)
//   - topic_materials: string (required, 1-2000 chars)
//   - learning_activities: list (required, max 50 items)
//   - student_present_count: int (required, 0-500)
//   - student_sick_count: int (required, 0-500)
//   - student_permit_count: int (required, 0-500)
//   - student_absent_count: int (required, 0-500)
//   - attendance_records: list (required, max 100 items)
//   - teacher_notes: string (optional, 0-3000 chars)
//   - photo_url: string (optional, 0-500000 chars, URL or compressed base64)
//   - completion_rate: number (optional, 0-100)
//   - is_substitute: bool (optional)
//   - original_teacher_id: string (optional, 0-100 chars)
//   - original_teacher_name: string (optional, 0-150 chars)
//   - is_locked: bool (required)
//   - submitted_at: string | timestamp (required, 1-50 chars or timestamp)
//
// Collection: substitutions
// Document ID: {subId}
// Fields:
//   - id: string (optional, 1-100 chars, immutable if present)
//   - institution_id: string (required, 1-100 chars, immutable if present)
//   - schedule_id: string (required, 1-100 chars)
//   - original_teacher_id: string (required, 1-100 chars)
//   - substitute_teacher_id: string (required, 1-100 chars)
//   - assign_date: string (required, 8-30 chars)
//   - reason: string (optional, 0-500 chars)
//   - created_by: string (required, 1-100 chars)
//   - created_at: string | timestamp (required, 1-50 chars or timestamp, immutable if present)
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Core Auth & Ownership Helpers
    // (Retained for future Firebase Anonymous/Custom Auth hardening)
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function uidUnchanged() {
      return !('uid' in request.resource.data) ||
        request.resource.data.uid == request.auth.uid;
    }

    function uidNotModified() {
      return !('uid' in request.resource.data) ||
        request.resource.data.uid == resource.data.uid;
    }

    // ===============================================================
    // General Validation Helper Functions
    // ===============================================================

    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    function isFieldUnchangedIfPresent(field) {
      return !(field in resource.data) ||
        (field in request.resource.data && request.resource.data[field] == resource.data[field]);
    }

    function isValidRequiredString(data, field, minLen, maxLen) {
      return (field in data) &&
        data[field] is string &&
        data[field].size() >= minLen &&
        data[field].size() <= maxLen;
    }

    function isValidOptionalString(data, field, minLen, maxLen) {
      return !(field in data) ||
        data[field] == null ||
        (
          data[field] is string &&
          data[field].size() >= minLen &&
          data[field].size() <= maxLen
        );
    }

    function isValidOptionalBool(data, field) {
      return !(field in data) ||
        data[field] == null ||
        data[field] is bool;
    }

    function isValidDateOrTimestamp(val) {
      return (val is string && val.size() >= 1 && val.size() <= 50) ||
        val is timestamp;
    }

    function isValidOptionalDateOrTimestamp(data, field) {
      return !(field in data) ||
        data[field] == null ||
        isValidDateOrTimestamp(data[field]);
    }

    function isValidOptionalList(data, field, maxSize) {
      return !(field in data) ||
        data[field] == null ||
        (data[field] is list && data[field].size() <= maxSize);
    }

    // ===============================================================
    // Domain Validator Functions (Used in BOTH create and update)
    // ===============================================================

    // 1. Institution Entity Validator
    function isValidInstitution(data) {
      return hasOnlyAllowedFields([
          'id', 'token_lembaga', 'name', 'education_level', 'npsn',
          'address', 'phone', 'logo_url', 'is_active', 'created_at'
        ]) &&
        hasRequiredFields(['token_lembaga', 'name', 'education_level', 'is_active', 'created_at']) &&
        isValidOptionalString(data, 'id', 1, 100) &&
        isValidRequiredString(data, 'token_lembaga', 2, 50) &&
        isValidRequiredString(data, 'name', 2, 200) &&
        data.education_level in ['SD', 'SMP', 'SMA', 'SMK', 'MI', 'MTs'] &&
        isValidOptionalString(data, 'npsn', 0, 30) &&
        isValidOptionalString(data, 'address', 0, 500) &&
        isValidOptionalString(data, 'phone', 0, 30) &&
        isValidOptionalString(data, 'logo_url', 0, 500000) &&
        data.is_active is bool &&
        isValidDateOrTimestamp(data.created_at);
    }

    // 2. User Entity Validator
    function isValidUser(data) {
      return hasOnlyAllowedFields([
          'id', 'institution_id', 'nip', 'name', 'phone', 'pin', 'role',
          'avatar_url', 'subject_name', 'subject_ids', 'is_active',
          'totp_enabled', 'totp_secret', 'email', 'created_at'
        ]) &&
        hasRequiredFields(['nip', 'name', 'pin', 'role', 'is_active']) &&
        isValidOptionalString(data, 'id', 1, 100) &&
        data.role in ['SUPER_ADMIN', 'ADMIN', 'TEACHER', 'HEADMASTER'] &&
        (
          data.role == 'SUPER_ADMIN'
            ? (!('institution_id' in data) || data.institution_id == null || (data.institution_id is string && data.institution_id.size() <= 100))
            : isValidRequiredString(data, 'institution_id', 1, 100)
        ) &&
        isValidRequiredString(data, 'nip', 1, 50) &&
        isValidRequiredString(data, 'name', 1, 150) &&
        isValidOptionalString(data, 'phone', 0, 30) &&
        isValidRequiredString(data, 'pin', 0, 128) &&
        isValidOptionalString(data, 'avatar_url', 0, 500000) &&
        isValidOptionalString(data, 'subject_name', 0, 200) &&
        isValidOptionalList(data, 'subject_ids', 50) &&
        data.is_active is bool &&
        isValidOptionalBool(data, 'totp_enabled') &&
        isValidOptionalString(data, 'totp_secret', 0, 128) &&
        isValidOptionalString(data, 'email', 0, 150) &&
        isValidOptionalDateOrTimestamp(data, 'created_at');
    }

    // 3. Class Entity Validator
    function isValidClass(data) {
      return hasOnlyAllowedFields([
          'id', 'institution_id', 'name', 'grade_level',
          'academic_year', 'homeroom_teacher_id', 'created_at'
        ]) &&
        hasRequiredFields(['institution_id', 'name', 'grade_level', 'academic_year']) &&
        isValidOptionalString(data, 'id', 1, 100) &&
        isValidRequiredString(data, 'institution_id', 1, 100) &&
        isValidRequiredString(data, 'name', 1, 100) &&
        (
          (data.grade_level is int && data.grade_level >= 1 && data.grade_level <= 20) ||
          (data.grade_level is string && data.grade_level.size() >= 1 && data.grade_level.size() <= 30)
        ) &&
        isValidRequiredString(data, 'academic_year', 4, 30) &&
        isValidOptionalString(data, 'homeroom_teacher_id', 0, 100) &&
        isValidOptionalDateOrTimestamp(data, 'created_at');
    }

    // 4. Student Entity Validator
    function isValidStudent(data) {
      return hasOnlyAllowedFields([
          'id', 'institution_id', 'class_id', 'nisn', 'nipd',
          'full_name', 'gender', 'is_active', 'created_at'
        ]) &&
        hasRequiredFields(['institution_id', 'class_id', 'nisn', 'full_name', 'gender', 'is_active']) &&
        isValidOptionalString(data, 'id', 1, 100) &&
        isValidRequiredString(data, 'institution_id', 1, 100) &&
        isValidRequiredString(data, 'class_id', 1, 100) &&
        isValidRequiredString(data, 'nisn', 1, 30) &&
        isValidOptionalString(data, 'nipd', 0, 30) &&
        isValidRequiredString(data, 'full_name', 1, 150) &&
        data.gender in ['L', 'P'] &&
        data.is_active is bool &&
        isValidOptionalDateOrTimestamp(data, 'created_at');
    }

    // 5. Subject Entity Validator
    function isValidSubject(data) {
      return hasOnlyAllowedFields([
          'id', 'institution_id', 'code', 'name', 'category', 'created_at'
        ]) &&
        hasRequiredFields(['institution_id', 'code', 'name', 'category']) &&
        isValidOptionalString(data, 'id', 1, 100) &&
        isValidRequiredString(data, 'institution_id', 1, 100) &&
        isValidRequiredString(data, 'code', 1, 30) &&
        isValidRequiredString(data, 'name', 1, 150) &&
        data.category in ['Wajib', 'Pilihan', 'Muatan Lokal'] &&
        isValidOptionalDateOrTimestamp(data, 'created_at');
    }

    // 6. Schedule Entity Validator
    function isValidSchedule(data) {
      return hasOnlyAllowedFields([
          'id', 'institution_id', 'teacher_id', 'class_id', 'subject_id',
          'day_of_week', 'start_period', 'end_period', 'start_time',
          'end_time', 'academic_year', 'semester', 'created_at'
        ]) &&
        hasRequiredFields([
          'institution_id', 'teacher_id', 'class_id', 'subject_id',
          'day_of_week', 'start_period', 'end_period', 'start_time',
          'end_time', 'academic_year', 'semester'
        ]) &&
        isValidOptionalString(data, 'id', 1, 100) &&
        isValidRequiredString(data, 'institution_id', 1, 100) &&
        isValidRequiredString(data, 'teacher_id', 1, 100) &&
        isValidRequiredString(data, 'class_id', 1, 100) &&
        isValidRequiredString(data, 'subject_id', 1, 100) &&
        data.day_of_week in ['Senin', 'Selasa', 'Rabu', 'Kamis', 'Jumat', 'Sabtu'] &&
        data.start_period is int && data.start_period >= 0 && data.start_period <= 20 &&
        data.end_period is int && data.end_period >= data.start_period && data.end_period <= 20 &&
        isValidRequiredString(data, 'start_time', 4, 10) &&
        isValidRequiredString(data, 'end_time', 4, 10) &&
        isValidRequiredString(data, 'academic_year', 4, 30) &&
        data.semester is int && (data.semester == 1 || data.semester == 2) &&
        isValidOptionalDateOrTimestamp(data, 'created_at');
    }

    // 7. Journal Entity Validator
    function isValidJournal(data) {
      return hasOnlyAllowedFields([
          'id', 'institution_id', 'schedule_id', 'actual_teacher_id',
          'teacher_name', 'class_name', 'subject_name', 'entry_date',
          'start_time', 'end_time', 'start_period', 'end_period',
          'learning_objective', 'topic_materials', 'learning_activities',
          'student_present_count', 'student_sick_count',
          'student_permit_count', 'student_absent_count',
          'attendance_records', 'teacher_notes', 'photo_url',
          'completion_rate', 'is_substitute', 'original_teacher_id',
          'original_teacher_name', 'is_locked', 'submitted_at'
        ]) &&
        hasRequiredFields([
          'institution_id', 'schedule_id', 'actual_teacher_id',
          'teacher_name', 'class_name', 'subject_name', 'entry_date',
          'start_time', 'end_time', 'start_period', 'end_period',
          'learning_objective', 'topic_materials', 'learning_activities',
          'student_present_count', 'student_sick_count',
          'student_permit_count', 'student_absent_count',
          'attendance_records', 'is_locked', 'submitted_at'
        ]) &&
        isValidOptionalString(data, 'id', 1, 100) &&
        isValidRequiredString(data, 'institution_id', 1, 100) &&
        isValidRequiredString(data, 'schedule_id', 1, 100) &&
        isValidRequiredString(data, 'actual_teacher_id', 1, 100) &&
        isValidRequiredString(data, 'teacher_name', 1, 150) &&
        isValidRequiredString(data, 'class_name', 1, 100) &&
        isValidRequiredString(data, 'subject_name', 1, 150) &&
        isValidDateOrTimestamp(data.entry_date) &&
        isValidRequiredString(data, 'start_time', 4, 10) &&
        isValidRequiredString(data, 'end_time', 4, 10) &&
        data.start_period is int && data.start_period >= 0 && data.start_period <= 20 &&
        data.end_period is int && data.end_period >= data.start_period && data.end_period <= 20 &&
        isValidRequiredString(data, 'learning_objective', 0, 2000) &&
        isValidRequiredString(data, 'topic_materials', 1, 2000) &&
        data.learning_activities is list && data.learning_activities.size() <= 50 &&
        data.student_present_count is int && data.student_present_count >= 0 && data.student_present_count <= 500 &&
        data.student_sick_count is int && data.student_sick_count >= 0 && data.student_sick_count <= 500 &&
        data.student_permit_count is int && data.student_permit_count >= 0 && data.student_permit_count <= 500 &&
        data.student_absent_count is int && data.student_absent_count >= 0 && data.student_absent_count <= 500 &&
        data.attendance_records is list && data.attendance_records.size() <= 100 &&
        isValidOptionalString(data, 'teacher_notes', 0, 3000) &&
        isValidOptionalString(data, 'photo_url', 0, 500000) &&
        (!('completion_rate' in data) || data.completion_rate == null || (data.completion_rate is number && data.completion_rate >= 0 && data.completion_rate <= 100)) &&
        isValidOptionalBool(data, 'is_substitute') &&
        isValidOptionalString(data, 'original_teacher_id', 0, 100) &&
        isValidOptionalString(data, 'original_teacher_name', 0, 150) &&
        data.is_locked is bool &&
        isValidDateOrTimestamp(data.submitted_at);
    }

    // 8. Substitute Assignment Entity Validator
    function isValidSubstitution(data) {
      return hasOnlyAllowedFields([
          'id', 'institution_id', 'schedule_id', 'original_teacher_id',
          'substitute_teacher_id', 'assign_date', 'reason',
          'created_by', 'created_at'
        ]) &&
        hasRequiredFields([
          'institution_id', 'schedule_id', 'original_teacher_id',
          'substitute_teacher_id', 'assign_date', 'created_by', 'created_at'
        ]) &&
        isValidOptionalString(data, 'id', 1, 100) &&
        isValidRequiredString(data, 'institution_id', 1, 100) &&
        isValidRequiredString(data, 'schedule_id', 1, 100) &&
        isValidRequiredString(data, 'original_teacher_id', 1, 100) &&
        isValidRequiredString(data, 'substitute_teacher_id', 1, 100) &&
        isValidRequiredString(data, 'assign_date', 8, 30) &&
        isValidOptionalString(data, 'reason', 0, 500) &&
        isValidRequiredString(data, 'created_by', 1, 100) &&
        isValidDateOrTimestamp(data.created_at);
    }

    // ===============================================================
    // Collection Rules
    // ===============================================================

    // Default deny for all unmatched paths
    match /{document=**} {
      allow read, write: if false;
    }

    // 1. Institutions Collection
    match /institutions/{institutionId} {
      allow read: if true;
      allow create: if isValidInstitution(request.resource.data);
      allow update: if isValidInstitution(request.resource.data) &&
        isFieldUnchangedIfPresent('id') &&
        isFieldUnchangedIfPresent('created_at');
      allow delete: if true;
    }

    // 2. Users Collection
    match /users/{userId} {
      allow read: if true;
      allow create: if isValidUser(request.resource.data);
      allow update: if isValidUser(request.resource.data) &&
        isFieldUnchangedIfPresent('id') &&
        isFieldUnchangedIfPresent('created_at');
      allow delete: if true;
    }

    // 3. Classes Collection
    match /classes/{classId} {
      allow read: if true;
      allow create: if isValidClass(request.resource.data);
      allow update: if isValidClass(request.resource.data) &&
        isFieldUnchangedIfPresent('id') &&
        isFieldUnchangedIfPresent('institution_id') &&
        isFieldUnchangedIfPresent('created_at');
      allow delete: if true;
    }

    // 4. Students Collection
    match /students/{studentId} {
      allow read: if true;
      allow create: if isValidStudent(request.resource.data);
      allow update: if isValidStudent(request.resource.data) &&
        isFieldUnchangedIfPresent('id') &&
        isFieldUnchangedIfPresent('institution_id') &&
        isFieldUnchangedIfPresent('created_at');
      allow delete: if true;
    }

    // 5. Subjects Collection
    match /subjects/{subjectId} {
      allow read: if true;
      allow create: if isValidSubject(request.resource.data);
      allow update: if isValidSubject(request.resource.data) &&
        isFieldUnchangedIfPresent('id') &&
        isFieldUnchangedIfPresent('institution_id') &&
        isFieldUnchangedIfPresent('created_at');
      allow delete: if true;
    }

    // 6. Schedules Collection
    match /schedules/{scheduleId} {
      allow read: if true;
      allow create: if isValidSchedule(request.resource.data);
      allow update: if isValidSchedule(request.resource.data) &&
        isFieldUnchangedIfPresent('id') &&
        isFieldUnchangedIfPresent('institution_id') &&
        isFieldUnchangedIfPresent('created_at');
      allow delete: if true;
    }

    // 7. Journals Collection
    match /journals/{journalId} {
      allow read: if true;
      allow create: if isValidJournal(request.resource.data);
      allow update: if isValidJournal(request.resource.data) &&
        isFieldUnchangedIfPresent('id') &&
        isFieldUnchangedIfPresent('institution_id');
      allow delete: if true;
    }

    // 8. Substitutions Collection
    match /substitutions/{subId} {
      allow read: if true;
      allow create: if isValidSubstitution(request.resource.data);
      allow update: if isValidSubstitution(request.resource.data) &&
        isFieldUnchangedIfPresent('id') &&
        isFieldUnchangedIfPresent('institution_id') &&
        isFieldUnchangedIfPresent('created_at');
      allow delete: if true;
    }
  }
}
